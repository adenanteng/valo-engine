# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=valo_engine
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_SSL=false

# Server Configuration
PORT=8083
TIMEZONE=Asia/Jakarta

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081,http://localhost:8083

# Admin Configuration
# Master admin key used to authenticate request to administrative routes
VALO_ADMIN_KEY=your_secure_admin_key_here

# Aria WhatsApp Integration Configuration
GRUPIA_API_URL=http://localhost:8080
GRUPIA_WEBHOOK_KEY=your_shared_webhook_key_here
ARIA_WHATSAPP_NUMBER=6281234567890

# SOCKS5 proxy for WhatsApp connections (recommended: Indonesia IP to avoid spam detection)
# Format: socks5://user:pass@host:port (leave empty to connect directly)
WHATSAPP_PROXY_URL=
