{
    "swagger": "2.0",
    "info": {
        "description": "Decoupled standalone microservice for Valo Engine (WhatsApp Bot \u0026 Messaging).",
        "title": "Valo Engine API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "email": "support@valoengine.io"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8083",
    "basePath": "/",
    "paths": {
        "/valo/accounts": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieve a list of all WhatsApp accounts connected to Valo engine",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Valo Engine"
                ],
                "summary": "List WhatsApp accounts",
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/controllers.ValoAccountsResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/valo/accounts/add": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Initiate pairing for a WhatsApp phone number and return the QR Code or 8-digit Pairing Code",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Valo Engine"
                ],
                "summary": "Add WhatsApp account / Get QR or Pairing Code",
                "parameters": [
                    {
                        "description": "Add Account Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.AddAccountRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/controllers.AddAccountResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/valo/accounts/{phone_number}/default": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Set a WhatsApp account as the default fallback for sending messages",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Valo Engine"
                ],
                "summary": "Set default WhatsApp account",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Phone Number",
                        "name": "phone_number",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/controllers.MessageResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/valo/accounts/{phone_number}/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Log out a WhatsApp account and terminate its active session",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Valo Engine"
                ],
                "summary": "Logout WhatsApp account",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Phone Number",
                        "name": "phone_number",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/controllers.MessageResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/valo/apikeys": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get all API keys generated for third-party integration",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Valo Engine"
                ],
                "summary": "List API Keys",
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/controllers.ValoApiKeysResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Generate a new API Key for third-party applications to access public endpoints",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Valo Engine"
                ],
                "summary": "Generate API Key",
                "parameters": [
                    {
                        "description": "Generate API Key Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.GenerateApiKeyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/controllers.ValoApiKeyResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/valo/apikeys/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Soft-delete an API key from the database by ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Valo Engine"
                ],
                "summary": "Delete API Key",
                "parameters": [
                    {
                        "type": "string",
                        "description": "API Key ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/controllers.MessageResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/valo/messages/send": {
            "post": {
                "security": [
                    {
                        "ValoApiKey": []
                    }
                ],
                "description": "Send a WhatsApp message (text and/or photo) to a recipient. Authentication via X-Valo-Key header is required.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Valo Engine"
                ],
                "summary": "Send WhatsApp message",
                "parameters": [
                    {
                        "description": "Send Message Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.SendMessageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/controllers.MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controllers.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controllers.AddAccountRequest": {
            "type": "object",
            "properties": {
                "method": {
                    "description": "\"qr\" or \"pair_code\"",
                    "type": "string",
                    "example": "qr"
                },
                "phone_number": {
                    "type": "string",
                    "example": "628123456789"
                }
            }
        },
        "controllers.AddAccountResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Scan this QR code or enter pairing code in WhatsApp"
                },
                "pairing_code": {
                    "type": "string",
                    "example": "ABCD-1234"
                },
                "qr_code": {
                    "type": "string",
                    "example": "data:image/png;base64,iVBORw0KGgoAAA..."
                }
            }
        },
        "controllers.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "error description"
                }
            }
        },
        "controllers.GenerateApiKeyRequest": {
            "type": "object",
            "properties": {
                "app_name": {
                    "type": "string",
                    "example": "Aplikasi Antrean"
                }
            }
        },
        "controllers.MessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Success"
                }
            }
        },
        "controllers.SendMessageRequest": {
            "type": "object",
            "properties": {
                "caption": {
                    "type": "string",
                    "example": "Ini adalah caption foto"
                },
                "image_base64": {
                    "type": "string",
                    "example": "data:image/png;base64,iVBORw0KGgoAAA..."
                },
                "image_url": {
                    "type": "string",
                    "example": "https://example.com/image.jpg"
                },
                "message": {
                    "type": "string",
                    "example": "Halo, ini adalah pesan uji coba."
                },
                "sender_number": {
                    "type": "string",
                    "example": "628987654321"
                },
                "to": {
                    "type": "string",
                    "example": "628123456789"
                }
            }
        },
        "controllers.ValoAccountsResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.ValoAccount"
                    }
                }
            }
        },
        "controllers.ValoApiKeyResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/models.ValoApiKey"
                }
            }
        },
        "controllers.ValoApiKeysResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.ValoApiKey"
                    }
                }
            }
        },
        "models.ValoAccount": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_default": {
                    "type": "boolean"
                },
                "phone_number": {
                    "description": "e.g., 6281234567890",
                    "type": "string"
                },
                "status": {
                    "description": "DISCONNECTED, CONNECTED",
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "models.ValoApiKey": {
            "type": "object",
            "properties": {
                "app_name": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "key": {
                    "description": "Pre-generated API Key",
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Enter Bearer token for Valo Engine admin endpoints",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        },
        "ValoAdminKey": {
            "description": "Enter Master Admin Key for Valo Engine admin endpoints",
            "type": "apiKey",
            "name": "X-Valo-Admin-Key",
            "in": "header"
        },
        "ValoApiKey": {
            "description": "Enter valid API key for Valo Engine public messaging endpoints",
            "type": "apiKey",
            "name": "X-Valo-Key",
            "in": "header"
        }
    }
}